<?xml version="1.0" encoding="UTF-8"?>
<svg width="800" height="600" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#f8faf9;stop-offset:0" />
      <stop offset="100%" style="stop-color:#edf2f0;stop-offset:1" />
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#2563eb;stop-offset:0" />
      <stop offset="100%" style="stop-color:#15c7a6;stop-offset:1" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="800" height="600" fill="url(#bgGrad)"/>
  <!-- Title -->
  <text x="400" y="100" text-anchor="middle" fill="#2d3d46" font-family="Inter, sans-serif" font-size="36" font-weight="600">
    Sistema de Gestão para Barbearia
  </text>
  <!-- Subtitle -->
  <text x="400" y="150" text-anchor="middle" fill="#506069" font-family="Inter, sans-serif" font-size="20">
    Paulo Ramos Case Study
  </text>
  <!-- Main illustration - simplified business system -->
  <g transform="translate(400,300)">
    <!-- Calendar -->
    <rect x="-150" y="-100" width="100" height="120" rx="10" fill="white" stroke="#dfe5e4" stroke-width="2"/>
    <rect x="-145" y="-95" width="10" height="20" fill="#2563eb"/>
    <rect x="-145" y="-65" width="10" height="20" fill="#2563eb"/>
    <rect x="-145" y="-35" width="10" height="20" fill="#2563eb"/>
    <text x="-100" y="-50" fill="#506069" font-family="Inter, sans-serif" font-size="14">Agenda</text>
    
    <!-- Customers -->
    <circle cx="0" cy="-50" r="30" fill="white" stroke="#dfe5e4" stroke-width="2"/>
    <circle cx="0" cy="-50" r="15" fill="#15c7a6"/>
    <circle cx="-20" cy="-65" r="8" fill="#15c7a6" opacity="0.7"/>
    <circle cx="20" cy="-65" r="8" fill="#15c7a6" opacity="0.7"/>
    <circle cx="-15" cy="-35" r="8" fill="#15c7a6" opacity="0.7"/>
    <circle cx="15" cy="-35" r="8" fill="#15c7a6" opacity="0.7"/>
    <text x="0" y="20" fill="#506069" font-family="Inter, sans-serif" font-size="14" text-anchor="middle">Clientes</text>
    
    <!-- Services -->
    <rect x="50" y="-100" width="100" height="120" rx="10" fill="white" stroke="#dfe5e4" stroke-width="2"/>
    <rect x="55" y="-95" width="90" height="15" fill="#2563eb" rx="5"/>
    <rect x="55" y="-70" width="70" height="15" fill="#2563eb" rx="5"/>
    <rect x="55" y="-45" width="50" height="15" fill="#2563eb" rx="5"/>
    <text x="100" y="-15" fill="#506069" font-family="Inter, sans-serif" font-size="14" text-anchor="middle">Serviços</text>
    
    <!-- Financial -->
    <rect x="-150" y="20" width="100" height="100" rx="10" fill="white" stroke="#dfe5e4" stroke-width="2"/>
    <polygon points="-100,40 -80,20 -60,40 -40,20 -20,40 0,20 20,40 40,20 60,40 80,20" fill="#15c7a6"/>
    <text x="-100" y="100" fill="#506069" font-family="Inter, sans-serif" font-size="12" text-anchor="middle">Financeiro</text>
    
    <!-- Connections -->
    <line x1="-50" y1="10" x2="0" y2="-50" stroke="#bbc4c8" stroke-width="3" opacity="0.7"/>
    <line x1="50" y1="10" x2="0" y2="-50" stroke="#bbc4c8" stroke-width="3" opacity="0.7"/>
    <line x1="-100" y1="70" x2="-50" y2="20" stroke="#bbc4c8" stroke-width="3" opacity="0.7"/>
    <line x1="0" y1="70" x2="50" y2="20" stroke="#bbc4c8" stroke-width="3" opacity="0.7"/>
  </g>
  
  <!-- Footer text -->
  <text x="400" y="550" text-anchor="middle" fill="#718087" font-family="Inter, sans-serif" font-size="16">
    Centralizando operações para maior eficiência e clareza
  </text>
  
  <!-- Decorative elements -->
  <circle cx="100" cy="100" r="40" fill="rgba(37, 99, 235, 0.1)"/>
  <circle cx="700" cy="500" r="40" fill="rgba(21, 199, 166, 0.1)"/>
</svg>
